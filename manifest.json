{
  "manifest_version": 3,
  "name": "מעקב חיפוש עבודה",
  "version": "1.0.0",
  "description": "תיעוד משרות שהגשתי, סטטוסים, וקשרים בלינקדאין בחברות",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "הוספת משרה",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "tracker.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
